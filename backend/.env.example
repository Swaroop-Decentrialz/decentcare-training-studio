# Port (Railway sets this automatically)
PORT=3001

# Allowed frontend origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# SmartFlo API base (don't change)
SMARTFLO_BASE=https://api-smartflo.tatateleservices.com

# Optional: lock down which SmartFlo tokens are valid (leave empty to allow any)
# SMARTFLO_TOKEN_PREFIX=Bearer
