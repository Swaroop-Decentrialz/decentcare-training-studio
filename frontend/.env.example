# Supabase — get from supabase.com → project → settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Railway backend proxy URL — get after deploying backend
VITE_RAILWAY_URL=https://your-railway-app.railway.app

# Anthropic — for client-side Claude calls (transcription/tagging)
VITE_ANTHROPIC_KEY=sk-ant-your-key-here
